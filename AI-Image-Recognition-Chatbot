        "\n",
        "import gradio as gr\n",
        "from PIL import Image\n",
        "\n",
        "def recognize_image(image):\n",
        "    if image is None:\n",
        "        return \"Please upload an image first.\"\n",
        "\n",
        "    # Convert the image into RGB format\n",
        "    image = image.convert(\"RGB\")\n",
        "\n",
        "    # Ask the AI model to recognize the image\n",
        "    predictions = classifier(image, top_k=5)\n",
        "\n",
        "    # Get the most likely result\n",
        "    best = predictions[0]\n",
        "\n",
        "    object_name = best[\"label\"].replace(\"_\", \" \").title()\n",
        "    confidence = best[\"score\"] * 100\n",
        "\n",
        "    # Create a chatbot-style response\n",
        "    response = f\"\"\"\n",
        "🤖 AI Chatbot Result\n",
        "\n",
        "I think this image contains: {object_name}\n",
        "\n",
        "Confidence score: {confidence:.2f}%\n",
        "\n",
        "Here are my other predictions:\n",
        "\"\"\"\n",
        "\n",
        "    for item in predictions:\n",
        "        label = item[\"label\"].replace(\"_\", \" \").title()\n",
        "        score = item[\"score\"] * 100\n",
        "        response += f\"\\n• {label}: {score:.2f}%\"\n",
        "\n",
        "    response += \"\\n\\nNote: This is an AI prediction and may not always be correct.\"\n",
        "\n",
        "    return response\n",
        "\n",
        "\n",
        "# Design the user interface\n",
        "with gr.Blocks(theme=gr.themes.Soft()) as app:\n",
        "\n",
        "    gr.Markdown(\"\"\"\n",
        "    # 🤖 AI Image Recognition Chatbot\n",
        "\n",
        "    Upload an image and let the AI identify what it sees!\n",
        "    \"\"\")\n",
        "\n",
        "    with gr.Row():\n",
        "        with gr.Column():\n",
        "            image_input = gr.Image(\n",
        "                type=\"pil\",\n",
        "                label=\"Upload Your Image\"\n",
        "            )\n",
        "\n",
        "            analyze_button = gr.Button(\n",
        "                \"🔍 Recognize Image\",\n",
        "                variant=\"primary\"\n",
        "            )\n",
        "\n",
